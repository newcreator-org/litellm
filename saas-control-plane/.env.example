# Control Plane Configuration
# Copy to .env and customize

# Control plane database (stores org metadata)
CP_DATABASE_URL=postgresql+asyncpg://llmproxy:dbpassword9090@localhost:5432/litellm_control_plane

# Shared PostgreSQL (stores per-org LiteLLM schemas)
CP_SHARED_PG_HOST=localhost
CP_SHARED_PG_PORT=5432
CP_SHARED_PG_USER=llmproxy
CP_SHARED_PG_PASSWORD=dbpassword9090
CP_SHARED_PG_DATABASE=litellm_saas

# Shared Redis
CP_REDIS_HOST=localhost
CP_REDIS_PORT=6379
CP_REDIS_PASSWORD=

# LiteLLM container image
CP_LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable

# Orchestrator: "docker" (local dev) or "flyio" (production)
CP_ORCHESTRATOR_BACKEND=docker

# Fly.io (only when CP_ORCHESTRATOR_BACKEND=flyio)
CP_FLY_API_TOKEN=
CP_FLY_ORG=personal
CP_FLY_REGION=nrt

# Management API key
CP_CONTROL_PLANE_API_KEY=sk-cp-dev-secret
